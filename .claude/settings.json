{
  "extraKnownMarketplaces": {
    "hypergrok": {
      "source": {
        "source": "github",
        "repo": "galleonlabs/hypergrok-trading-desk",
        "ref": "v1.7.1"
      }
    }
  },
  "enabledPlugins": {
    "hypergrok@hypergrok": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/exchange_write_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
